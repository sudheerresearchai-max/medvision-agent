# ============================================================================
# MedVision Agent — environment template
#
# RESEARCH PROTOTYPE ONLY — NOT APPROVED FOR CLINICAL DIAGNOSIS.
# Never commit real keys. Copy to .env.local and fill what you need.
# Every variable here is OPTIONAL; the app degrades gracefully.
# ============================================================================

# --- Inference service (Hugging Face Space or local FastAPI) -----------------
# Base URL, no trailing slash. Leave EMPTY to use built-in mock inference.
INFERENCE_API_URL=http://127.0.0.1:8000
# Abort a predict call after this many milliseconds.
INFERENCE_TIMEOUT_MS=45000

# --- Supabase (optional persistence) -----------------------------------------
# When both are set, cases/jobs/results/reports persist to Postgres.
# SERVICE ROLE KEY bypasses RLS — server-side only, NEVER prefix with
# NEXT_PUBLIC_ and never ship it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Optional LLM-based clinical extraction ----------------------------------
# Any OpenAI-compatible chat completions endpoint. Empty = rules only.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# --- OCR (optional, experimental) ---------------------------------------------
# 1 = attempt Tesseract.js on scanned PDFs flagged OCR_REQUIRED.
# NOTE: tesseract.js must be installed manually (`npm i tesseract.js`) and has
# heavy canvas/rendering requirements on Vercel — see lib/pdfExtract.ts.
OCR_ENABLED=0
